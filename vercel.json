{
  "functions": {
    "api/interview.js": {
      "maxDuration": 60
    },
    "api/callback.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
